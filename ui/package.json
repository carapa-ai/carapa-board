{
  "name": "carapa-board-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --exclude src/test-utils/browser-runtime.vitest.ts",
    "test:browser-runtime": "vitest run src/test-utils/browser-runtime.vitest.ts",
    "build": "vite build",
    "build:ota": "vite build && bun scripts/package-ota.ts",
    "typecheck": "tsc --noEmit && node scripts/check-fields.mjs && node scripts/check-native-title.mjs",
    "cap:sync": "bun run build:ota && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/http": "^0.0.2",
    "@capacitor/local-notifications": "^8.1.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.4",
    "@capgo/capacitor-share-target": "^8.0.29",
    "@capgo/capacitor-updater": "^8.51.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.141.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "capacitor-native-biometric": "^4.2.2",
    "capacitor-voice-recorder": "^7.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.7.0",
    "dompurify": "^3.4.13",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.16.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/android": "8.3.1",
    "@capacitor/cli": "8.3.1",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/router-plugin": "^1.141.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
