    "@babel/runtime": "^7.26.10",
    "@xmldom/xmldom": "^0.9.12",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.7",
    "esbuild": "0.27.4",
    "form-data": "^4.0.6",
    "postcss": "^8.5.23",
    "rollup": "^4.59.0",
    "seroval": "^1.5.3",
    "tar": "^7.5.21",
    "tmp": "^0.2.6"
  }
}
