API_PORT=3099
DATA_DIR=data-test
# Process-sub tests mark their children as test mode (NODE_ENV=test); the config loader then loads this file instead of .env.
ENABLE_MESSAGING=false
ENABLE_SCHEDULER=false
ENABLE_MEMORY_REFLECTOR=true
ENABLE_RUN_SYSTEM_PROMPT_TRANSCRIPTS=true
WEB_VIEW_MAX_CHARS=50000
AUTO_START_SANBOXES=false

# JEV_URL is set by src/test-preload.ts to an in-process mock Jev server.
MEMORY_CAPSULE_ENGINE=jev
# Planning calls a real LLM; tests opt in explicitly with injected planners.
MEMORY_CAPSULE_QUERY_PLAN=off
JEV_API_KEY=
JEV_TIMEOUT_MS=20000
#JEV_SHADOW_LOG_PATH=data/jev-shadow.jsonl
#MEMORY_JUDGE_TIMEOUT_MS=60000

PUBLIC_SAFETY_JUDGE_ENGINE=jev
KNOWLEDGE_VERIFY_ENGINE=jev
