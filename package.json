{
  "name": "carapa-board",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:production": "tsc --noEmit -p tsconfig.production.json",
    "rebuild": "bash scripts/rebuild.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop carapa-board",
    "pm2:logs": "pm2 logs carapa-board",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "knip": "knip",
    "knip:gate": "knip --no-progress --include files,dependencies,unlisted,binaries,unresolved",
    "verify": "bash scripts/verify.sh",
    "verify:browser": "bash scripts/test-browser.sh",
    "build:browser-viewer": "bash scripts/build-browser-viewer.sh",
    "verify:changed": "bash scripts/verify-changed.sh",
    "build:transcripts-skill": "bun scripts/build-transcripts-skill.ts",
    "check:transcripts-skill": "bun scripts/build-transcripts-skill.ts --check",
    "analyze:tool-quality": "bun scripts/analyze-tool-quality.ts",
    "maintain:session-transcripts": "bun scripts/maintain-session-transcripts.ts",
    "test": "bash scripts/test-ci.sh bun",
    "test:changed": ". ./scripts/load-test-env.sh && LOG_LEVEL=silent bun test --no-env-file --changed=HEAD --only-failures --path-ignore-patterns '**/*.browser.test.ts' --path-ignore-patterns '**/*.browser.test.tsx'",
    "test:ui": "bash scripts/test-browser.sh",
    "test:ci": "bash scripts/test-ci.sh",
    "test:ci:android": "bash scripts/test-ci.sh android",
    "test:ci:backend": "bash scripts/test-ci.sh backend",
    "test:ci:contracts": "bash scripts/test-ci.sh contracts",
    "test:ci:ui": "bash scripts/test-ci.sh ui",
    "test:full": "bash scripts/test-ci.sh bun",
    "ui:sandbox": "bash scripts/ui-sandbox/run.sh",
    "ui:audit": "bun scripts/ui-sandbox/ui-audit.ts",
    "ui:sandbox:smoke": "bun scripts/ui-sandbox/start.ts --smoke --no-browser",
    "ui:sandbox:mobile-kanban": "UI_SANDBOX_SMOKE_SCENARIO=mobile-kanban bun scripts/ui-sandbox/start.ts --smoke --no-browser",
    "ui:sandbox:manual-overflow": "UI_SANDBOX_SMOKE_SCENARIO=manual-overflow bun scripts/ui-sandbox/start.ts --smoke --no-browser",
    "ui:sandbox:security": "UI_SANDBOX_SMOKE_SCENARIO=security bun scripts/ui-sandbox/start.ts --smoke --no-browser",
    "ui:sandbox:two-user": "bash scripts/ui-sandbox/run.sh --two-user"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "0.1.80",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "fflate": "^0.8.2",
    "linkedom": "^0.18.12",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "neo4j-driver": "^6.0.1",
    "openai": "^4.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "turndown": "^7.2.4",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "bun-types": "latest",
    "knip": "^6.47.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "^7.0"
  },
  "overrides": {
    "hono": "^4.13.16",
    "@hono/node-server": "^2.1.6",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "form-data": "^4.0.6",
    "ip-address": "^10.7.4",
    "path-to-regexp": "^8.4.0",
    "qs": "^6.16.1",
    "express-rate-limit": ">=8.2.2",
    "proxy-addr": "^2.0.8"
  },
  "engines": {
    "bun": ">=1.0"
  }
}
