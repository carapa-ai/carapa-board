#include <tunables/global>

# AppArmor profile for CarapaBoard container
# Applies to: carapa-board (Kanban board + chat UI, Bun/Express web app)
#
# Purpose: Allow the web app to serve HTTP/WebSocket, read/write SQLite,
#          access project directories, and connect to MCP servers — while
#          blocking access to sensitive system files and host resources.
#
# Key difference from controller: no Docker socket access.
# Key difference from agent: no workspace exec, no broad binary exec.

profile carapabox-board flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # ── Network ──────────────────────────────────────────────────────
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  network netlink raw,          # getifaddrs / route lookups

  # ── Capabilities ────────────────────────────────────────────────
  # None required — runs as non-root UID 1000

  # ── Deny sensitive paths (deny rules always win) ────────────────
  deny /etc/shadow rwklx,
  deny /etc/gshadow rwklx,
  deny /etc/sudoers rwklx,
  deny /etc/sudoers.d/** rwklx,
  deny /proc/*/environ r,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/sys/** w,
  deny /proc/kcore rwklx,
  deny /proc/kmsg rwklx,
  deny /sys/** w,
  /sys/fs/cgroup/** r,           # Bun reads cgroup memory limits
  deny /root/** rwklx,
  deny /dev/sd* rwklx,
  deny /dev/nvme* rwklx,
  deny /dev/xvd* rwklx,
  deny /dev/vd* rwklx,
  deny mount,

  # ── Application (read + execute) ────────────────────────────────
  / r,                           # Bun reads root directory on startup
  /app/ r,                       # Bun reads app directory itself
  /app/** r,                     # Application source (TS runs directly)
  /app/src/** mrix,              # Bun JIT on source files
  /app/node_modules/** mrix,     # Bun JIT on dependencies

  # ── Application data (read-write bind mounts) ──────────────────
  /app/data/** rwkl,             # SQLite database + WAL locking
  /app/groups/** rwkl,           # Per-project working directories (k=lock for git index.lock, l=link for git atomic renames)
  /app/store/** rwkl,            # Persistent state storage
  /app/ipc/** rwkl,             # Active run state tracking (k,l for locks if needed)
  /app/logs/ rwl,                # Log directory (creation of log files)
  /app/logs/** rwkl,             # Log files

  # ── Application assets (read-only) ─────────────────────────────
  /app/prompts/** r,             # Prompt templates
  /app/ui/dist/** r,             # Built frontend assets
  /app/.env r,                   # Environment config (ro bind mount)

  # ── System binaries & libraries (read + execute + mmap exec) ──
  / r,
  /bin/ r,
  /usr/bin/ r,
  /sbin/ r,
  /usr/sbin/ r,
  /usr/** mrix,
  /lib/** mrix,                  # Includes musl dynamic linker
  /lib64/** mrix,
  /bin/sh mrix,
  /bin/bash mrix,
  /bin/busybox mrix,             # Alpine base binary
  /bin/mkdir mrix,
  /usr/bin/touch mrix,
  /usr/bin/tee mrix,
  /usr/bin/wget mrix,            # for healthcheck
  /bin/** mrix,                  # core utilities
  /sbin/** mrix,                 # system utilities
  /usr/local/bin/bun mrix,        # Bun runtime
  /opt/bun/** mrix,              # Bun alternative path

  # ── System config (read-only) ─────────────────────────────────
  /etc/passwd r,
  /etc/group r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/host.conf r,
  /etc/nsswitch.conf r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,
  /etc/ld.so.cache r,
  /etc/ld.so.conf r,
  /etc/ld.so.conf.d/** r,
  /etc/localtime r,
  /etc/timezone r,
  /etc/bash.bashrc r,
  /etc/profile r,
  /etc/profile.d/ r,
  /etc/profile.d/** r,
  /etc/inputrc r,
  /etc/terminfo/** r,
  /etc/wgetrc r,               # wget config
  /etc/alternatives/** r,

  # ── Temp & runtime (writable tmpfs) ────────────────────────────
  /tmp/** rwkmix,
  /run/** rw,

  # ── Device access ──────────────────────────────────────────────
  /dev/null rw,
  /dev/zero r,
  /dev/full rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/console rw,
  /dev/pts/* rw,
  /dev/ptmx rw,
  /dev/shm/** rwm,
  /dev/fd/** rw,

  # ── Proc (filtered) ───────────────────────────────────────────
  /proc/ r,
  /proc/sys/kernel/random/uuid r,
  /proc/sys/kernel/hostname r,
  /proc/sys/kernel/osrelease r,
  /proc/sys/kernel/ngroups_max r,
  /proc/sys/vm/overcommit_memory r,
  /proc/sys/vm/mmap_min_addr r,   # Bun checks mmap lower bound
  /proc/sys/net/** r,
  /proc/self/** r,
  /proc/tty/drivers r,
  /proc/[0-9]*/cmdline r,
  /proc/[0-9]*/stat r,
  /proc/[0-9]*/statm r,           # Bun reads memory stats
  /proc/[0-9]*/mem r,             # Bun reads own process memory
  /proc/[0-9]*/status r,
  /proc/[0-9]*/fd/** rw,
  /proc/[0-9]*/fdinfo/** r,
  /proc/[0-9]*/maps r,
  /proc/[0-9]*/mounts r,
  /proc/[0-9]*/mountinfo r,
  /proc/[0-9]*/net/** r,
  /proc/[0-9]*/task/** r,
  /proc/[0-9]*/cgroup r,
  /proc/meminfo r,
  /proc/cpuinfo r,
  /proc/filesystems r,
  /proc/stat r,
  /proc/loadavg r,
  /proc/uptime r,
  /proc/version r,

  # ── Signal handling ────────────────────────────────────────────
  signal,
  ptrace read peer=carapabox-board,
}
