# CarapaBoard environment configuration example.
# Copy to .env and adjust values for your setup.

# ── Server ──────────────────────────────────────────────────────────────────
#API_PORT=3000
# Extra names for the HTTPS certificate the entrypoint issues on first boot from its
# local CA (store/certs/ca.crt), besides localhost, carapa-board and 127.0.0.1.
# To reissue, move store/certs/server.{crt,key} aside and restart (docs/tls-cert-trust.md).
#CARAPA_BOARD_CERT_SANS=DNS:board.home.arpa,IP:192.168.1.20
#ASSISTANT_NAME=Capa
#TZ=America/New_York
# Maximum characters for conversation handoff prompts.
#MAX_HANDOFF_LENGTH=32000
# Review rejections after which a task is paused for manual resolution. Counts
# rejections since the last human retry out of Question (agent moves do not restart it).
#MAX_REVIEW_REJECTIONS=8

# ── Browser network detection ───────────────────────────────────────────────
# Comma-separated custom LAN hostnames that should display as Home. The server
# exposes this non-secret list to web clients at runtime. localhost, private IP
# addresses, and *.local names are recognized automatically.
#VITE_LOCAL_HOSTNAMES=board.lan,board.home.arpa

# ── Published ports ─────────────────────────────────────────────────────────
# docker-compose.yml publishes the Board (3000) and PostgreSQL (5433) on the
# loopback interface only. Set 0.0.0.0 (or a LAN address) to reach the Board
# from other machines, ideally behind the ingress/TLS setup. Keep the database
# bind on loopback unless you need remote database access.
#CARAPA_BOARD_BIND=127.0.0.1
#CARAPA_BOARD_DB_BIND=127.0.0.1

# ── CORS ────────────────────────────────────────────────────────────────────
# Controls which browser origins may call the board API.
#
# Unset (default) — same-origin only: the web UI served by the Board works, and
# only the Android/Capacitor app origins (http://localhost, https://localhost,
# capacitor://localhost) also get CORS headers.
# Set one or more comma-separated origins to allow other browser origins:
#   CORS_ORIGIN=https://board.carapa.ai
#   CORS_ORIGIN=https://board.carapa.ai,http://localhost:5173
# '*' allows every origin and logs a warning at startup.
#CORS_ORIGIN=

# ── Secrets ──────────────────────────────────────────────────────────────────
# Sign-in is always required. On first start Board creates the `admin` user
# with a random password printed once in its log.
# SECRETS_DIR=/home/youruser/.carapa/secrets/board

# ── CarapaBox ────────────────────────────────────────────────────────────────
#CARAPA_BOX_URL=http://localhost:3100
# CarapaBox service name used by the admin "Build app" button and restart (unset = feature off).
#CARAPA_BOARD_DEPLOY_SERVICE=carapa-board
# Project folder that gets a fix card when an administrator-requested build fails (unset = off).
#BOARD_BUILD_FAILURE_PROJECT=carapa-board
#CARAPA_BOX_API_TOKEN=changeme
#or save it in your secrets folder as `carapa_box_api_token`
#DEFAULT_SANDBOX_STACK=carapa-bot
# Poll enabled projects for unseen open GitLab issues every 10 minutes.
#ISSUE_IMPORT_POLL_INTERVAL_MS=600000

# Optional direct path for Brain APIs behind CarapaBox's ingress proxy.
# See docs/BRAIN-INGRESS.md before enabling; requires an approved static source IP.
#COMPOSE_FILE=docker-compose.yml:docker-compose.ingress.yml
#BRAIN_INGRESS_HOST=172.29.255.2
# Brains receive `board_started` / `box_started` events when the Board starts or
# CarapaBox restarts. Set to 0 to disable both (default: enabled).
#BRAIN_SYSTEM_EVENTS=0
#BOARD_INGRESS_IP=172.29.255.4
#BOARD_INGRESS_NETWORK=carapa_ingress_edge

# ── WhatsApp (CarapaWaLink) ──────────────────────────────────────────────────
# Disabled by default. Set to "true" to enable WhatsApp messaging via CarapaWaLink (coming soon).
#ENABLE_WHATSAPP=true
# Folder of the operator's main project; required for first-pairing self-chat auto-link.
#WHATSAPP_SELF_CHAT_MAIN=main-admin
# Enables generated sandbox URLs and project-level nginx hostname aliases.
#ENABLE_NGINX_PROXY=false
# Number of reverse-proxy hops in front of CarapaBoard. Set to 1 for a direct
# nginx/cloudflared -> CarapaBoard deployment so rate limits use the client IP.
#TRUST_PROXY_HOPS=1
# Public origins (comma-separated, scheme + host[:port]) from which remote MCP
# clients (Claude Code, Codex, Cursor) may connect with a browser login (OAuth
# 2.1). The request host must match an entry; unset = MCP OAuth is disabled and
# its endpoints return 404.
#CARAPA_BOARD_PUBLIC_ORIGINS=https://board.example.com,https://board.internal.example
#MCP_MESSAGING_PROVIDER=carapa-wa-link
#MCP_WHATSAPP_URL=http://localhost:3467/mcp
#CARAPA_WA_LINK_TOKEN=changeme
#or save it in your secrets folder as `carapa_wa_link_token`

# ── Data directories ─────────────────────────────────────────────────────────
# Override to store data/ store/ groups/ outside the project root.
#CARAPA_DATA_DIR=/path/to/data

# Read-only Codex state used when an admin pastes a codex://threads/... link
# into project chat. Searches CODEX_IMPORT_HOME, AGENT_HOME/.codex, the project's
# sandbox IPC codex-home, CODEX_HOME, and ~/.codex (duplicate paths are skipped).
#CODEX_IMPORT_HOME=/home/youruser/.codex
# Docker Compose exposes Codex homes read-only. Set AGENT_HOME to
# the same host directory used by the CarapaBot stack for its /home/ubuntu mount:
#AGENT_HOME=/path/to/agent-home
# Point this existing setting at the Codex home, not its sessions/ subdirectory.
# The importer reads sessions/ and session_index.jsonl beneath it.
#CODEX_IMPORT_SESSIONS_HOST_DIR=/home/youruser/.codex
#CODEX_IMPORT_AGENT_HOME=/alternative/board-visible/agent-codex-home
# Project sandbox history is already visible under data/ipc/<stack>-<instance>/codex-home.

# Read-only Claude state for scripts/import-native-conversations.ts --source claude.
# Point these at Claude homes (the folder containing projects/), not projects/ itself.
# Mounted at /app/claude-import and /app/claude-agent-import (AGENT_HOME/.claude).
#CLAUDE_IMPORT_SESSIONS_HOST_DIR=/home/youruser/.claude

# Read-only VS Code Chat history for --source vscode. Point this at the VS Code
# User data directory (contains workspaceStorage/ and globalStorage/), mounted at
# /app/vscode-import by docker-compose.override.local.yml.
#VSCODE_IMPORT_SESSIONS_HOST_DIR=/home/youruser/.config/Code/User

# Optional independently-updatable embedded Playwright dashboard. This host
# directory is mounted read-only at /app/ui/dist/browser-viewer; the default
# follows the checked-out Board repository.
#BROWSER_VIEWER_DIR=/path/to/carapa-board/ui/public/browser-viewer
# Close unviewed, idle shared browsers and their preview servers after 15 minutes.
# Conversations and worktrees are retained. Set to 0 to disable idle expiry.
#BROWSER_IDLE_TIMEOUT_MS=900000
# Cut the static tail off Testing-stage browser recordings after the run ends
# (uses the Board image's ffmpeg). Set to 0 to keep recordings untouched.
#CARAPA_RECORD_TRIM=1


# ── PostgreSQL resilience ───────────────────────────────────────────────────
# Bound a query on both the client and server so a broken connection cannot
# leave an API or MCP request waiting forever. Defaults are 30 seconds.
#PG_QUERY_TIMEOUT_MS=30000
#PG_STATEMENT_TIMEOUT_MS=30000
# Retire pooled connections periodically and use TCP keepalive to detect dead
# Docker-network peers. Defaults: 300 seconds and 10 seconds respectively.
#PG_POOL_MAX_LIFETIME_SECONDS=300
#PG_KEEPALIVE_DELAY_MS=10000

# ── Transcript Memory Reflector ─────────────────────────────────────────────
# Reflects directly on transcript chunks with recall/memorize/forget tools
# after chats and tasks, through defaults.reflector in data/board_agents.jsonc.
# It does not preload project memories. Off by default: point defaults.reflector
# at a working model first (the setup skill asks which one). The flag also
# gates DirectLLM's manual /reflect command; the agents' memorize/recall tools
# follow ENABLE_MEMORY instead.
#ENABLE_MEMORY_REFLECTOR=false
# LLM timeout for one automatic reflector chunk (several tool calls). Default 5 minutes.
#REFLECTOR_CHUNK_TIMEOUT_MS=300000
# Interval of the sweep that queues durable pending live reflector rows (idle
# for 10+ minutes) which this process is not running, e.g. rows written by
# another process. Default 120000 (2 minutes); 0 disables the sweep.
#REFLECTOR_PENDING_SWEEP_INTERVAL_MS=120000

# Memory-capsule selection engine (MEMORY_CAPSULE_ENGINE). Picks which filter
# decides which recalled candidates reach the agent:
#   off (default) - no engine; keep every collected candidate unfiltered
#   llm  - LLM relevance judge selects the candidates (at most 8, best
#          first; it may select none)
#   shadow - LLM judge selects, plus Jev scores the capsule's candidates in
#            the background and logs agreement ("jev_shadow"); agent-visible
#            capsules are unchanged
#   jev  - keep candidates with Jev score >= JEV_MIN_SCORE and skip the LLM
#          judge; if Jev fails, the LLM judge runs as before. Scores all
#          candidates (ignores JEV_MAX_CANDIDATES).
# "shadow" and "jev" additionally require JEV_URL to be set. The self-hosted
# Laya service ranks ~125 ms per candidate on CPU, so keep the cap/timeout modest.
#MEMORY_CAPSULE_ENGINE=off   (off | llm | shadow | jev)
#JEV_MIN_SCORE=1
#JEV_URL=http://api-relay:8080/laya
#JEV_BATCH=false   (true only for self-hosted Laya, which has /v1/systemone/batch; the hosted API does not)
#JEV_MODEL=jev-latest   (checkpoint; the hosted API requires one)
#JEV_API_KEY=
#JEV_TIMEOUT_MS=20000
#JEV_MAX_CANDIDATES=32
# Automatic failover to the hosted Jev when the primary JEV_URL (e.g. a local
# ninfer GPU server) is down: a network error, timeout or HTTP 5xx is retried
# once against the fallback. Unset JEV_FALLBACK_URL = no failover. The fallback
# URL must NOT be in PRIVACY_LOCAL_ENDPOINT_PREFIXES: projects with privacyMode
# strict or local_memory then refuse it and see the primary error, as before.
# Hosted Jev may score differently from ninfer; JEV_MIN_SCORE, the knowledge
# threshold (0.5) and the web injection threshold (0.8) were tuned on ninfer.
#JEV_FALLBACK_URL=http://api-relay:8080/jev
#JEV_FALLBACK_MODEL=jev-latest   (default: JEV_MODEL)
#JEV_FALLBACK_BATCH=false   (the hosted API has no batch endpoint)
#JEV_FALLBACK_API_KEY=
# Circuit breaker: after this many consecutive primary failures, skip the
# primary and use the fallback for the cooldown, then try the primary again.
#JEV_BREAKER_FAILURES=3
#JEV_BREAKER_COOLDOWN_MS=300000
#JEV_SHADOW_LOG_PATH=/path/to/jev-shadow.jsonl   (default: <data dir>/jev-shadow.jsonl)
#WEB_CONTENT_SCREENING=warn   (warn | off; needs JEV_URL: warn adds a warning line to web_view/web_search results that appear to instruct the agent; off = envelope only)
#WEB_INJECTION_THRESHOLD=0.8   (Jev injection probability 0-1 at or above which web content is flagged)
#WEB_VIEW_MAX_CHARS=50000   (size of each web_view chunk; longer pages are read with the offset paging line)

# Memory-capsule query planning (on by default). Before recalling, Jev (if
# JEV_URL is set) judges whether stored memories could help at all (score below
# MEMORY_CAPSULE_GATE_MIN on its 0-2 scale skips the capsule), and the
# defaults.reflector LLM proposes 2-5 short search queries recalled alongside
# the raw prompt. Gate or planner failures fall back to plain raw-prompt recall.
#MEMORY_CAPSULE_QUERY_PLAN=on   (on | off)
#MEMORY_CAPSULE_GATE_MIN=0.5
#MEMORY_CAPSULE_PLAN_TIMEOUT_MS=4000
# Memory reflector gate (MEMORY_REFLECTOR_GATE). "shadow" additionally scores
# each chunk of an automatic live reflector run with Jev (needs JEV_URL) and
# logs the scores beside the chunk's memory-operation count. It never skips or
# changes a chunk, and no transcript text is logged. Both shadow sites (the
# memory capsule and the reflector gate) append to JEV_SHADOW_LOG_PATH, told
# apart by the "site" field ("memory-capsule" | "reflector-gate").
#MEMORY_REFLECTOR_GATE=off   (off | shadow)
# Automatic model-tier routing: classify a request into fast / balanced /
# frontier through Jev before choosing a model. "jev" requires JEV_URL; any
# other value means off. There is no shadow mode.
#MODEL_ROUTING_ENGINE=off   (off | jev)
# Engine for the public-persona safety gate. "jev" classifies content through
# Jev (requires JEV_URL), fails closed when Jev is unavailable, and makes a
# configured defaults.publicSafetyJudge runtime optional. Any other value means llm.
#PUBLIC_SAFETY_JUDGE_ENGINE=llm   (llm | jev)
# Engine for the knowledge-search chunk verifier. "jev" scores each chunk's match
# probability through Jev (requires JEV_URL), drops a chunk it cannot verify, and
# returns no results when every candidate is dropped (no LLM fallback, no
# unfiltered fallback). Any other value means llm.
#KNOWLEDGE_VERIFY_ENGINE=llm   (llm | jev)
# Append every chat Auto routing decision, including the routed message text,
# to <data>/ipc/<stack>-<instance>/routing/<conversationId>.jsonl.
#MODEL_ROUTING_LOG=false
#MEMORY_JUDGE_TIMEOUT_MS=20000

# The DirectLLM runtime used by peek_files is configured with
# defaults.peekFiles in data/board_agents.jsonc. If unset there, peek_files
# falls back to the current runtime, the default chat binding, or another
# configured HTTP-capable direct binding (in that order).

# ── Sandbox / Agent ─────────────────────────────────────────────────────────
#AGENT_CMD=claude
#MCP_AGENT_TIMEOUT=1800
# Overall deadline for web_view's delegated Playwright agent. Default 90000 (90s), kept under MCP clients' 300s idle timeout.
#WEB_BROWSER_AGENT_TIMEOUT_MS=90000
# web_search falls back to a Google-grounded Gemini call via api-relay when SearXNG has no results.
# Empty URL disables it. Counts against the Antigravity per-model quota.
#WEB_SEARCH_GROUNDING_URL=http://api-relay:8080/antigravity
#WEB_SEARCH_GROUNDING_MODEL=gemini-3-flash
# Browser sidecar uses a separate shared secret file in SECRETS_DIR.
#WEB_BROWSER_SIDECAR_URL=http://web-browser:3210
#WEB_BROWSER_AGENT_GATEWAY_URL=ws://api-relay:8080/board-api
#WEB_BROWSER_MAX_SESSIONS=4
# Browser tabs on native (Mac) runners lease a hub browser, separately from web_view.
# The sidecar enforces the session limit and renewal window; Board renews up to the maximum lifetime.
#WEB_BROWSER_TAB_MAX_SESSIONS=2
#WEB_BROWSER_TAB_LEASE_MS=1200000
#WEB_BROWSER_TAB_MAX_LIFETIME_MS=14400000
#WEB_BROWSER_IMAGE=carapa-bot-agent:latest
# Deadline for an individual agent tool call. Tools that intentionally wait on
# people or delegated agents declare their own lifecycle. Default 45000 (45s).
#MCP_TOOL_TIMEOUT_MS=45000
#DEFAULT_SANDBOX_STACK=carapa-bot
#DEFAULT_SANDBOX_SERVICE=agent
# Board-visible directories (comma-separated) holding the shared template files
# that generated rule/skill links point at. A rule/skill proposal can preview and
# replace a linked item only when its link resolves inside the project or here.
#PROPOSAL_TEMPLATE_ROOTS=/app/templates
# Approving a platform / group_template / objective_template proposal commits it
# to the carapa-agent-kit repository through a fixed script run in this sandbox
# project (`bun <board repo>/scripts/apply-promotion.ts`). Its /workspace must
# contain the kit checkout on the branch named below and a CarapaBoard checkout
# (only used to locate that script). Agents see the commit only after the next
# `scripts/install.sh` run from the kit.
#PROMOTION_SANDBOX_PROJECT=carapa
#PROMOTION_BOARD_REPO_DIR=/workspace/carapa-board
#PROMOTION_KIT_REPO_DIR=/workspace/carapa-agent-kit
#PROMOTION_KIT_BRANCH=main
#TRANSCRIPT_ARCHIVE_DAYS=3
# Per-call timeout for a single `sandbox_git` MCP call. A worktree diff with
# hundreds of untracked files batches into one call and finishes in well under
# a second; this is just a ceiling for a stuck sandbox so the HTTP worker
# doesn't sit on a hung call forever. Default 60000 (60s).
#RUN_GIT_TIMEOUT_MS=60000
# Slow-request warn threshold for git-heavy routes (conversation diff, commit-
# message suggestion, /git/* reads). Default 5000 (5s). Bump higher if your
# sandbox is slow and you don't want the log flooded with "slow request" lines.
#REQUEST_SLOW_MS_GIT=5000

# ── Encryption ───────────────────────────────────────────────────────────────
# Hex-encoded 32-byte key for encrypting brainAuthToken at rest.
# If unset, auto-generated to DATA_DIR/.encryption-key on first boot.
# Generate with: openssl rand -hex 32
#CARAPA_BOARD_ENCRYPTION_KEY=
# or save it in your secrets folder as `carapa_board_encryption_key`

# ── Whisper (voice transcription) ───────────────────────────────────────────
# Audio transcription endpoint. Works with OpenAI, Groq, or local Whisper.
# For local: no API key needed, just set the URL.
# For OpenAI: set WHISPER_API_KEY to your OpenAI API key.
# For Groq: set URL to https://api.groq.com/openai/v1/audio/transcriptions
#            and WHISPER_MODEL=whisper-large-v3
#WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
#WHISPER_MODEL=whisper-1
#WHISPER_API_KEY=sk-...

# ── Streaming dictation and Live Mode voice input ──────────────────────────
# Realtime browser audio stays on the authenticated CarapaBoard origin. The
# board retains each locally detected phrase and posts it to this internal
# CUDA Speaches endpoint. If the whole GPU session fails, WHISPER_API_URL above
# becomes the CPU fallback. Leave LIVE_STT_LANGUAGE empty for automatic
# multilingual detection.
#LIVE_STT_API_URL=http://whisper-realtime:8080/v1/audio/transcriptions
#LIVE_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
#LIVE_STT_LANGUAGE=

# ── TTS (text-to-speech, Supertonic 3) ──────────────────────────────────────
# Agent voice replies for the board UI / Android app, via a self-hosted Supertonic
# service. Enabled by default; set ENABLE_TTS=false to disable.
# TTS_API_URL points at the `supertonic serve` container (Docker DNS).
#ENABLE_TTS=false
#TTS_API_URL=http://supertonic:7788
#TTS_MODEL=supertonic-3
#TTS_VOICE=M1          # M1..M5, F1..F5, or an imported custom voice
#TTS_LANG=en           # 31 langs + 'na' (e.g. de, ro). Caller passes already-normalized text.
#TTS_DETECT_LANGUAGES=en,ro,de,fr,es,it,pt,nl,pl,ru,uk,hu,cs,bg,el,sv,tr
#                      # Languages Jev may detect a text in, so server and device voices speak the
#                      # text's own language (needs JEV_URL; else the persona's language is used).
#                      # The persona's language and TTS_LANG are always included; max 20 are used.
#TTS_STEPS=10          # denoising steps 1..100 (quality vs latency)
#TTS_SPEED=1.05        # 0.7..2.0
#TTS_FORMAT=ogg        # wav | flac | ogg (no mp3/opus)
#TTS_MAX_CHUNK_CHARS=240   # sentence-chunk size for pseudo-streaming
#ENABLE_TTS_NORMALIZE=true # LLM cleanup before synth (numbers→words, currency, abbreviations,
                           # sentence segmentation, per language). Uses the project's default
                           # selected v2 chat runtime when it exposes HTTP transport. Off → plain split.
#ENABLE_TTS_EXPRESSIONS=true # Allow validated <laugh>, <breath>, and <sigh> persona expressions.
#TTS_CACHE_REVISION=supertonic-3:1 # bump when engine output changes without a model-name change
#TTS_CACHE_TRANSIENT_TTL_DAYS=7   # unlinked previews/status audio only
#TTS_CACHE_MAX_BYTES=2147483648   # soft limit for unlinked cached audio

# ── Vector Store (Neo4j) ────────────────────────────────────────────────────
# Semantic similarity search for memories. Disabled by default.
# Requires Neo4j and an embedding API (Ollama).
#ENABLE_VECTOR_STORE=true
#NEO4J_URI=bolt://localhost:7687
#NEO4J_USER=neo4j
#NEO4J_PASSWORD=changeme #use docker secret instead
#EMBEDDING_MODEL=embeddinggemma
#EMBEDDING_API_URL=http://localhost:11434/api/embed
#EMBEDDING_DIMENSIONS=768
#VECTOR_ONLY_RECALL=false
#VECTOR_MIN_SCORE=0.7
# Max Neo4j memory nodes without a SQL row deleted per group per maintenance pass
# (lowest ids first; the rest are logged as `remaining` and go on later passes).
# Default 20000 equals the sweep's scan cap, so one pass clears a backlog.
#ORPHAN_SWEEP_MAX_DELETE_PER_PASS=20000

# External privacy-erasure: when a memory is [forgotten]/`forget`-ed, also
# scrub the matching facts from Neo4j vector/graph stores, observation
# journals, and sandbox journal copies, with a durable retry queue for
# outages. Default OFF — [forgotten]/forget performs SQL-only erasure (the
# memory row is deleted and the privacy-erasure epoch advances) while the
# external half awaits a bounded redesign. Turn on to revive external erasure.
#ENABLE_EXTERNAL_PRIVACY_ERASURE=false

# ── Features ─────────────────────────────────────────────────────────────────
# Enable objectives/SMART goals feature (requires carapa-brain agent, coming soon)
# ENABLE_OBJECTIVES=true

# ── Logging ──────────────────────────────────────────────────────────────────
#LOG_LEVEL=info
#LOG_COLOR=true
# Docker json-file rotation defaults: 10 MiB per file, 5 files (50 MiB total).
#LOG_MAX_SIZE=10m
#LOG_MAX_FILES=5
# Also write JSON log lines (same redaction as stderr) to a size-rotated file.
# Rotates to LOG_FILE.1 … LOG_FILE.N. Unset = stderr only. Pretty dev output stays on stderr; the file is always JSON. docker-compose.yml
# sets this to /app/logs/board.log (the ./logs mount).
#LOG_FILE=/app/logs/board.log
#LOG_FILE_MAX_SIZE=20m
#LOG_FILE_MAX_FILES=5

# ── Toggles ─────────────────────────────────────────────────────────────────
# Subsystems are on by default. Set to 'false' to disable for debugging or
# lightweight deploys.
#ENABLE_SCHEDULER=false
#ENABLE_SERVICE_WATCHER=false
# Set to 'false' to skip starting sandboxes at boot. Queued executable-stage
# tasks and dataset chains are still resumed at boot (sandboxes start on demand).
#AUTO_START_SANDBOXES=false
# Set to 0 to stop the 10-minute sweep that merges review-approved cards parked
# by a refused (e.g. dirty default checkout) merge.
#TASK_MERGE_RETRY_SWEEP=0
#SHOW_SANDBOX_PORTS=true
# Restart project sandboxes onto rebuilt images (e.g. after a host build) when
# they are idle, one sandbox at a time. Checked every minute through CarapaBox.
# A long process in a sandbox can delay this (and other automatic restarts)
# until it exits: `restart-hold run NAME CMD...` inside the sandbox.
#AUTO_RESTART_OUTDATED_SANDBOXES=true
# Service watcher interval in ms. Minimum 5000 (invalid or lower values are
# replaced); each watcher job never overlaps itself.
#SERVICE_WATCHER_INTERVAL=15000
#ENABLE_CHAT=false
#
#ENABLE_KANBAN=false
# GitNexus is off by default; enable it with docker-compose.gitnexus.yml
# (see docs/gitnexus-integration.md).
#ENABLE_GITNEXUS=true
#GITNEXUS_REGISTRY_PATH=/app/data/gitnexus/registry.json


# ── Video ───────────────────────────────────────────────────────────────────
# Video processing settings for attachments.
# VIDEO_FPS: frames per second to extract (default: 1)
# VIDEO_MAX_DURATION: maximum duration in seconds to process (default: 60)
#ENABLE_VIDEO=true
#VIDEO_FPS=1
#VIDEO_MAX_DURATION=60

# ── Run System Prompt Transcripts ───────────────────────────────────────────
# Persist each run's exact system prompt as session-transcripts/<runId>.system.txt.
# Disabled by default; set true to write system-prompt.txt into run dirs.
#ENABLE_RUN_SYSTEM_PROMPT_TRANSCRIPTS=false

# ── Push notifications (FCM) ────────────────────────────────────────────────
# Mobile push for the Capacitor Android app (and iOS later). Both vars are
# required to enable push; if either is unset, the notify_user / ping_user
# MCP tools return a clear "push not configured" error.
#
# FCM_PROJECT_ID: the project ID from the Firebase Console.
# FCM_SERVICE_ACCOUNT_PATH: path to a service-account JSON. Mount as a Docker
#   secret in production; never commit the file.
#
# Push carries no content — only an opaque ref. The app fetches the real
# payload over the existing signed-request channel.
#FCM_PROJECT_ID=carapa-board-prod
#FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm_service_account.json

# CarapaMail MCP endpoint the board (DirectLLM) connects to. The board derives the
# attachment-download base from this (the URL minus /mcp) and re-hosts downloaded
# attachments under /uploads, so this host must be reachable from the board container.
#CARAPA_MAIL_MCP_URL=http://carapa-mail-carapamail-1:3477/mcp

# ── Image generation ────────────────────────────────────────────────────────
# Experimental personal-use GPT Image path through ChatGPT/Codex OAuth owned
# by api-relay. Disabled by default; Gemini cloud-image remains the fallback.
#ENABLE_GPT_IMAGE_OAUTH=true
#GPT_IMAGE_MODEL=gpt-image-2
#IMAGE_GENERATION_RELAY_URL=http://api-relay:8080/codex
#CLOUD_IMAGE_URL=http://api-relay:8080/cloud-image
#IMAGE_GENERATION_TIMEOUT_MS=600000
# Avatar generation has a longer default because the admin UI waits for the
# synchronous provider response. Value is milliseconds (default: 15 minutes).
#AVATAR_GENERATION_TIMEOUT_MS=900000

# Optional path to the CarapaBox seccomp profile for the web-browser sidecar.
#WEB_BROWSER_SECCOMP_PROFILE=../carapa-box/security/seccomp-default.json

# Operator-only deployment: when this .env and a copy of docker-compose.yml live
# outside the checkout, point Compose back at the checkout and at a private copy
# of the board's seccomp profile. quick-install.sh sets these.
#CARAPA_BOARD_SOURCE_DIR=/home/youruser/carapa/carapa-board
#CARAPA_BOARD_SECCOMP_PROFILE=/home/youruser/.carapa/deploy/security/seccomp-web.json

# Comma-separated URL prefixes of runtimes that keep content on this host.
# Matching is path-aware (scheme, host, port, then path segments), so
# http://api-relay:8080/laya matches /laya and /laya/v1 but not /anthropic or
# /layax. Unset = every runtime without an explicit board_agents `locality`
# declaration is treated as remote.
# Once any project sets privacyMode, unattributed memory/Jev/embedding calls to
# endpoints not listed here are refused, so list the local llama-proxy,
# embedding and Jev prefixes here first.
# DirectLLM calls judge locality from the URL only (primary and capacity
# fallback), so a binding declared `locality: "local"` in board_agents must also
# have its URL prefix listed here, or DirectLLM requests to it are refused.
#PRIVACY_LOCAL_ENDPOINT_PREFIXES=http://llama-proxy:11434,http://api-relay:8080/laya
